{
  "$description": "Erase.me design tokens. Extracted from docs/design/source/*.dc.html and reconciled with docs/agents/design-agent.md. Frequencies are counts across all 34 boards.",
  "font": {
    "family": { "sans": "Inter, system-ui, sans-serif", "mono": "ui-monospace, monospace" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 },
    "features": "'tnum'",
    "size": { "10": "10px", "11": "11px", "12": "12px", "13": "13px", "14": "14px", "15": "15px", "17": "17px", "22": "22px", "28": "28px", "32": "32px", "38": "38px", "52": "52px" },
    "letterSpacing": { "tight": "-0.02em", "tighter": "-0.03em", "display": "-0.04em", "caps": "0.04em" }
  },
  "color": {
    "bg": "#F5F6F8",
    "surface": "#FFFFFF",
    "surfaceHover": "#F8F9FB",
    "tile": "#F0F2F6",
    "line": "#E6E8EC",
    "lineSoft": "#EEF0F4",
    "inputBorder": "#D5D9E0",
    "ink": "#0B1220",
    "muted": "#5B6475",
    "accent": "#2F55F4",
    "accentSoft": "#EBF0FF",
    "status": {
      "bad":     { "fg": "#C62828", "bg": "#FDECEC" },
      "good":    { "fg": "#14733F", "bg": "#E6F4EC" },
      "warn":    { "fg": "#8A5A00", "bg": "#FFF3D6" },
      "neutral": { "fg": "#5B6475", "bg": "#EEF0F4" },
      "info":    { "fg": "#2F55F4", "bg": "#EBF0FF" }
    },
    "warningBar": "#B8861B",
    "dark": { "bg": "#0B1220", "line": "#1B2434", "muted": "#8C96AB", "hover": "rgba(127,140,170,.14)" }
  },
  "radius": { "control": "8px", "card": "12px", "panel": "16px", "chip": "999px" },
  "spacing": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "12": "48px", "24": "96px" },
  "border": { "width": "1px" },
  "shadow": {
    "floating": "0 12px 40px rgba(11,18,32,.06)",
    "accentButton": "0 6px 18px rgba(47,85,244,.22)"
  },
  "focus": { "ring": "2px solid #2F55F4", "offset": "2px" },
  "motion": { "hover": "150ms ease" },
  "touchTarget": { "phoneMin": "44px" },
  "layout": { "phone": { "w": 390, "h": 844 }, "desktop": { "w": 1440, "h": 900 } }
}
