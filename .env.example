# Copy to .env for local development. Never commit real values.
NODE_ENV=development

# Core API
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000
# App connects as the restricted role; migrations run as the owner role.
DATABASE_URL=postgres://erase_api:erase_api@localhost:5432/erase
DATABASE_MIGRATION_URL=postgres://erase:erase@localhost:5432/erase
REDIS_URL=redis://localhost:6379
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=

# Gmail token encryption: base64 of 32 random bytes (openssl rand -base64 32). Required in production.
TOKEN_MASTER_KEY=

# Public base URL of the API. The Google redirect URI is this + /v1/auth/google/callback
# (register http://localhost:4000/v1/auth/google/callback in Google Cloud for local development).
API_PUBLIC_URL=http://localhost:4000
# Leave empty for localhost. Set (for example .erase.me) only when web and API share a parent domain.
COOKIE_DOMAIN=

# Google OAuth, test mode. Sign-in asks for openid, email and profile only. Connecting an inbox is a separate
# consent for gmail.readonly (scan, metadata only) and gmail.send (used only after the user approves a request).
# Leave empty to use the fake Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Scan limits (optional). Years of mail to scan, counted back from the scan start; empty scans the whole mailbox.
SCAN_WINDOW_YEARS=
# Stop a scan after this many matching messages (default 50000).
SCAN_MAX_MESSAGES=
# Senders to leave out of results, comma separated: your employer's domains, or full addresses.
# Your own addresses are always left out.
SCAN_EXCLUDE=

# Real sends are OFF by default. Dev and test send only to the fake Gmail.
ALLOW_REAL_SEND=false
REAL_SEND_DAILY_CAP=5

# AI service
LLM_API_KEY=
